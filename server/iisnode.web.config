<?xml version="1.0"?>
<!-- Opt-in candidate ONLY. Verify Windows App Service Node/iisnode support before deployment. -->
<configuration>
  <system.webServer>
    <handlers>
      <add name="blog-node" path="runtime/iisnode-entry.js" verb="*" modules="iisnode" />
    </handlers>
    <rewrite>
      <rules>
        <rule name="Preserve API routes" stopProcessing="true">
          <match url="^api(/.*)?$" ignoreCase="true" />
          <action type="None" />
        </rule>
        <rule name="Blog metadata and static assets" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="runtime/iisnode-entry.js" />
        </rule>
      </rules>
    </rewrite>
    <iisnode loggingEnabled="false" devErrorsEnabled="false" />
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
